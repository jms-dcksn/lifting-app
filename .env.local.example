# Explicit development target check; never use a production secret for evals.
EVAL_DB_PROJECT_REF=uggyizzzczwwxkgnwuse
EVAL_USER_EMAIL=jms.dcksn88@gmail.com
# Optional timestamp: resolved to an immutable dataset version before execution.
EVAL_DATASET_VERSION=
# Supply an available fixed Jev model id if supported; default jev-latest is floating.
JEV_MODEL=

# Persistent Coach inbox: enable only after migration + matching private DB key provision.
COACH_INBOX_ENABLED=false
COACH_COMMAND_SIGNING_KEY=
