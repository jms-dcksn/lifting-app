    {
      "id": "claim_df4c746ef85a4e55a76d8f6fe26fc8eb",
      "statement": "Every user-owned table follows a uniform ownership RLS pattern: a not-null user_id column referencing auth.users on delete cascade, row-level security enabled, and a policy restricting rows to user_id = auth.uid() (profile uses id = auth.uid() instead); this RLS check is the primary enforcement mechanism for per-user data isolation.",
