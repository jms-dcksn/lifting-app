    {
      "id": "claim_e64ff300f84b4bab993104d73cd92084",
      "statement": "The weekly Coach API (GET /api/coach/v1/weekly) is the sole elevated read path in the application: it has no browser session so it uses a separate server-held secret client that bypasses RLS, and every query on that path carries an explicit COACH_API_USER_ID predicate; the route is capability-token gated, read-only, and no-store/noindex.",
      "evidence": [
        {
