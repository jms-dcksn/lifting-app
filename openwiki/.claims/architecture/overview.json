  "claims": [
    {
      "id": "claim_dedce62370b045f28dbab1e2b3a85fa7",
      "statement": "The app is organized in three layers: a framework-free strength engine (src/lib/strength/) with no Next.js/Supabase imports, server loaders and Server Actions that are the only code talking to Postgres, and an App Router UI layer where Server Components render hydrated data and a small set of Client Components handle interaction.",
      "evidence": [
        {
          "resource": "repo://docs/architecture.html#L696-L745",
          "version": "repo-lines-v1:sha256:dde19e21d64388463c507005933bf4010225fd26789a2d8bb5a65a7b2b590041:"
        }
      ]
    },
    {
      "id": "claim_f6c833f4ecf84c3fb76cd482f96757b2",
      "statement": "src/proxy.ts (the Next.js 16 replacement for middleware.ts) runs on every matched request except static assets/_next/HMR, calls updateSession() to rotate Supabase auth cookies, and deliberately does not redirect unauthenticated users.",
      "evidence": [
        {
          "resource": "repo://src/proxy.ts",
          "version": "repo-file-v1:sha256:5ec23b449ab1781aef3ec87cce3ccc010e150e63997f9a7ab7136fced7026333"
        }
      ]
    },
    {
      "id": "claim_41905c80b2fe4e318990b09f4a3ec631",
      "statement": "(app)/layout.tsx is the real access-control gate: it builds a Supabase client, calls auth.getClaims(), and redirects to /login when claims are missing; Server Actions independently re-check auth via their own requireUser()-style helper rather than relying on the layout.",
