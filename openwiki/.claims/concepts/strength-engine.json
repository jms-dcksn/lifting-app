  "claims": [
    {
      "id": "claim_e019fd7011f34d7cafdd9f24ecd48d64",
      "statement": "e1rm.ts computes e1RM using an RPE/RIR load table (the RPE-10 column of the RTS table, keyed by reps-to-failure 1-12, linearly interpolated) rather than a bare Epley/Brzycki formula, because effective reps-to-failure equals reps performed plus RIR (RPE = 10 - RIR).",
      "evidence": [
        {
          "resource": "repo://docs/DECISIONS.md#L19-L22",
          "version": "repo-lines-v1:sha256:8bd9f271864a7d4d92184e7f4f0334eb1c07aaac17ccc883c646e5864e362fae:"
        },
        {
