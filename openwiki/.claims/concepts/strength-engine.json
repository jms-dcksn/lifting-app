        }
      ]
    },
    {
      "id": "claim_84278ce95ca24570b7f49e81effbd6cd",
      "statement": "Beyond reps-to-failure of 12, pctOf1RM switches to an Epley-shaped decay anchored to the table's last point so the curve stays continuous and monotonic across the boundary.",
