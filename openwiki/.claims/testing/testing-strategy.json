    {
      "id": "claim_09ca196e5de34d82a94d8423ea21ecb0",
      "statement": "CI (.github/workflows/ci.yml) runs two independent jobs on push to main and on pull requests: an `app` job (npm ci, lint, tsc --noEmit, npm test, then npm run build with placeholder Supabase env vars) and a `database` job (npm ci, npx supabase start, npm run test:db, npx supabase stop with if: always()), so an app-tier failure and an RLS regression are reported as separately required checks.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/ci.yml#L1-L58",
          "version": "repo-lines-v1:sha256:64406535adcce47855f57e25513ab5cc38906d8428f56a566fa63999903479c5:"
