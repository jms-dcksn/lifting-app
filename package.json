{
  "name": "lifting-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/check-hosted-migrations.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "eval:agent": "EVAL_LIVE=1 vitest run src/lib/agent/evals/live-experiment.test.ts",
    "eval:agent:follow-ups": "EVAL_SCENARIOS=follow-ups npm run eval:agent",
    "eval:agent:all": "EVAL_SCENARIOS=all npm run eval:agent",
    "test:watch": "vitest",
    "test:db": "supabase test db supabase/tests/*_rls.sql",
    "test:db:compatibility": "tsx scripts/test-workout-start-compatibility.ts",
    "eval:agent:sync": "tsx scripts/agent-evals.ts sync",
    "eval:agent:regrade": "tsx scripts/agent-evals.ts regrade",
    "test:db:concurrency": "node scripts/test-coach-concurrency.mjs && node scripts/test-coach-actions-concurrency.mjs && node scripts/test-workout-editor-concurrency.mjs && node scripts/test-workout-details-concurrency.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "typecheck:indexed": "tsc --project tsconfig.indexed.json",
    "verify": "node scripts/verify.mjs",
    "test:browser": "playwright test",
    "test:agent": "vitest run src/lib/agent src/lib/coach-invariants.test.ts",
    "test:agent:persistence": "node scripts/test-agent-persistence.mjs",
    "prepare": "lefthook install",
    "check:commit": "node scripts/git-hooks.mjs commit",
    "check:push": "node scripts/git-hooks.mjs push",
    "test:hooks": "node --test scripts/git-hooks.test.mjs scripts/session-hooks.test.mjs scripts/pr-verification.test.mjs",
    "eval:weekly:export": "tsx scripts/weekly-coach-evals.ts",
    "eval:weekly": "EVAL_LIVE=1 EVAL_WEEKLY_LIVE=1 vitest run src/lib/agent/evals/weekly-experiment.test.ts",
    "check:langsmith": "tsx scripts/check-langsmith.ts",
    "verify:pr": "node scripts/pr-verification.mjs"
  },
  "dependencies": {
    "@langchain/anthropic": "1.5.12",
    "@langchain/core": "1.2.14",
    "@langchain/langgraph": "1.4.16",
    "@langchain/langgraph-checkpoint": "1.2.2",
    "@langchain/langgraph-checkpoint-postgres": "1.1.2",
    "@langchain/langgraph-sdk": "1.11.1",
    "@langchain/openai": "1.6.2",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "deepagents": "1.16.0",
    "langchain": "1.5.11",
    "langsmith": "0.9.0",
    "next": "16.2.6",
    "pg": "8.16.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "server-only": "0.0.1",
    "ws": "8.22.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "fast-check": "4.3.0",
    "jsdom": "^29.1.1",
    "lefthook": "2.2.2",
    "supabase": "^2.116.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
